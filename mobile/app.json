{
  "expo": {
    "name": "Ясно",
    "slug": "yasno",
    "scheme": "yasno",
    "version": "1.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "backgroundColor": "#131714",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ru.yasno.almanac"
    },
    "android": {
      "package": "ru.yasno.almanac",
      "edgeToEdgeEnabled": true
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": ["expo-router"],
    "experiments": {
      "typedRoutes": false
    }
  }
}
